---
import { siteConfig } from "../config";

const hasPublications =
  siteConfig.publications && siteConfig.publications.length > 0;
---

{
  hasPublications && (
    <section id="publications" class="p-8 sm:p-12 md:p-16 lg:p-24">
      <div>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
          <div class="lg:col-span-4">
            <h2 class="text-3xl sm:text-4xl md:text-5xl xl:text-7xl font-bold text-gray-900">
              Publications
            </h2>
            <div
              class="w-[75px] h-[5px] mt-2 rounded-full"
              style={`background-color: ${siteConfig.accentColor}`}
            />
            <p class="mt-4 text-sm text-gray-500">
              Peer-reviewed papers
            </p>
          </div>

          <div class="lg:col-span-8">
            <div class="space-y-6">
              {siteConfig.publications.map((publication) => {
                const Component = publication.link ? "a" : "div";
                const linkProps = publication.link
                  ? {
                      href: publication.link,
                      target: "_blank",
                      rel: "noopener noreferrer",
                    }
                  : {};

                return (
                  <Component
                    {...linkProps}
                    class={`block bg-white rounded-lg shadow-sm border border-gray-100 p-4 sm:p-5 md:p-6 transition-all duration-300 ${
                      publication.link
                        ? "hover:shadow-md hover:border-gray-200"
                        : ""
                    }`}
                  >
                    <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-2 sm:gap-4 mb-3">
                      <h3 class="text-lg sm:text-xl font-semibold text-gray-900 leading-snug">
                        {publication.title}
                      </h3>
                      <span class="text-xs sm:text-sm text-gray-500 sm:whitespace-nowrap">
                        {publication.date}
                      </span>
                    </div>

                    <p
                      class="text-base sm:text-lg"
                      style={`color: ${siteConfig.accentColor}`}
                    >
                      {publication.venue}
                    </p>

                    <p class="mt-1 text-sm text-gray-500">
                      {publication.authors}
                    </p>

                    {publication.status && (
                      <span
                        class="inline-block mt-3 mb-1 text-xs font-medium px-2 py-1 rounded-full"
                        style={`background-color: ${siteConfig.accentColor}14; color: ${siteConfig.accentColor}`}
                      >
                        {publication.status}
                      </span>
                    )}

                    {publication.description && (
                      <p class="mt-3 text-sm sm:text-base text-gray-600 leading-relaxed">
                        {publication.description}
                      </p>
                    )}
                  </Component>
                );
              })}
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}
