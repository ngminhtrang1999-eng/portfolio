---
import { siteConfig } from "../config";

const hasAwards = siteConfig.awards && siteConfig.awards.length > 0;
---

{
  hasAwards && (
    <section id="awards" class="p-8 sm:p-12 md:p-16 lg:p-24">
      <div>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
          <div class="lg:col-span-4">
            <h2 class="text-3xl sm:text-4xl md:text-5xl xl:text-7xl font-bold text-gray-900">
              Awards
            </h2>
            <div
              class="w-[75px] h-[5px] mt-2 rounded-full"
              style={`background-color: ${siteConfig.accentColor}`}
            />
            <p class="mt-4 text-sm text-gray-500">
              Competitions, scholarships &amp; honors
            </p>
          </div>

          <div class="lg:col-span-8">
            <div class="space-y-6">
              {siteConfig.awards.map((award) => {
                const Component = award.link ? "a" : "div";
                const linkProps = award.link
                  ? {
                      href: award.link,
                      target: "_blank",
                      rel: "noopener noreferrer",
                    }
                  : {};

                return (
                  <Component
                    {...linkProps}
                    class={`block bg-white rounded-lg shadow-sm border border-gray-100 p-4 sm:p-5 md:p-6 transition-all duration-300 ${
                      award.link ? "hover:shadow-md hover:border-gray-200" : ""
                    }`}
                  >
                    <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between mb-3">
                      <div>
                        <h3 class="text-lg sm:text-xl font-semibold text-gray-900">
                          {award.title}
                        </h3>
                        <p
                          class="text-base sm:text-lg"
                          style={`color: ${siteConfig.accentColor}`}
                        >
                          {award.issuer}
                        </p>
                      </div>
                      <span class="text-xs sm:text-sm text-gray-500 mt-2 sm:mt-0 sm:pl-4 sm:whitespace-nowrap">
                        {award.date}
                      </span>
                    </div>

                    {award.description && (
                      <p class="text-sm sm:text-base text-gray-600 leading-relaxed">
                        {award.description}
                      </p>
                    )}
                  </Component>
                );
              })}
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}
